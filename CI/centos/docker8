                      gcc-gfortran gcc-c++ clang bzip2 \
                      root root-physics root-mathcore root-mathmore root-matrix root-genvector root-foam \
                      HepMC3-rootIO-devel HepMC3-devel HepMC3-search HepMC3-search-devel  HepMC3-rootIO HepMC3  HepMC python3  &&  yum -y  clean all
